# Set these in Railway > Service > Variables (never commit real keys).

# AI provider: "anthropic", "openai" (any OpenAI-compatible API) or "none" (default, app works without AI)
AI_PROVIDER=none

# Secret key of the chosen provider
AI_API_KEY=

# Model name. Suggested cheap default for anthropic: claude-haiku-5-5
AI_MODEL=claude-haiku-5-5

# Only for AI_PROVIDER=openai (Groq, OpenRouter, Gemini OpenAI-compat, etc.)
# Example: https://api.groq.com/openai/v1
AI_BASE_URL=

# Max AI requests per visitor (IP) per day, to cap cost
DAILY_LIMIT=20
